# Токен Telegram-бота (обязательно). Получить: @BotFather
BOT_TOKEN=

# Ключ шифрования паролей календарей (обязательно, 32 байта base64)
# Сгенерировать: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=

# Telegram ID администраторов бота через запятую (админ-панель, команды /admin и /create)
ADMIN_IDS=

# DSN базы данных (по умолчанию SQLite в корне проекта).
# При запуске в docker-compose этот параметр переопределяется на sqlite+aiosqlite:////data/bot.db
DATABASE_URL=sqlite+aiosqlite:///bot.db

# Интервал опроса Codeforces API, секунды
PARSE_INTERVAL_SECONDS=600

# Интервал проверки напоминаний, секунды
REMIND_INTERVAL_SECONDS=10

# Разрешить пользователям подключать CalDAV-серверы по локальным адресам
# (localhost, 127.0.0.1, 192.168.x.x и т.п.). По умолчанию запрещено.
ALLOW_LOCAL_CALDAV=false
